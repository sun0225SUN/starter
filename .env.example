# Umami. Public, because the browser loads these scripts.
# Host can be a domain or an origin, for example umami.guoqi.dev
NEXT_PUBLIC_UMAMI_HOST=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Local Docker default. Replace this in production.
DATABASE_URL=postgresql://starter:starter@localhost:5432/starter

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google and GitHub sign-in. Both values are required for each provider.
# Redirect URLs:
#   http://localhost:3000/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
